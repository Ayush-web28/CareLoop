{
  "name": "careloop",
  "version": "0.1.0",
  "description": "Alexa+ caretaking assistant: a self-hosted MCP server (Streamable HTTP) plus a simulated Alexa+ web client.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/smoke.ts",
    "build": "node scripts/build-lambda.mjs",
    "test:lambda": "npm run build && tsx scripts/smoke-lambda.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1140.0",
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1140.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
